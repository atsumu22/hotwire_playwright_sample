<div data-modal-target="modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 <%= local_assigns[:open] ? '' : 'hidden' %>"
  aria-labelledby="modal-title" role="dialog" aria-modal="<%= local_assigns[:open] ? 'true' : 'false' %>"
  data-action="click->modal#closeBackground keydown@window->modal#closeWithKeyboard"
  tabindex="-1"
>
  <div class="fixed inset-0 bg-black opacity-50"></div>

  <div data-modal-target="content"
       class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6 animate-fade-in-scale">
    <%# ヘッダー %>
    <div class="flex justify-between items-center border-b pb-3 mb-4">
      <h3 class="text-xl font-semibold text-gray-800" id="modal-title" data-modal-target="title">
        <%= local_assigns[:title] || "モーダルのタイトル" %>
      </h3>
      <button type="button" data-action="modal#close" class="text-gray-400 hover:text-gray-600 text-2xl">
        &times;
      </button>
    </div>

    <%= turbo_frame_tag "modal_content_frame" do %>
      <% if content_for?(:modal_content) %>
        <%= yield :modal_content %>
      <% end %>
    <% end %>

  </div>
</div>